@model List<_24_july_Practice.Models.StudentDetails>

@{
    ViewData["Title"] = "Dashboard";
}

<h2>Student Details</h2>

<h3>Welcome @Context.Session.GetString("User")</h3>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Course</th>
        <th>Email</th>
        <th>Mobile</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Course</td>
            <td>@item.Email</td>
            <td>@item.Mobile</td>
        </tr>
    }
</table>

<br />

<a asp-action="Logout">Logout</a>