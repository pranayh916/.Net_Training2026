@model _21_july.Models.Student

@{
    ViewData["Title"] = "Student Registration";
}

<h2>Student Registration</h2>

<form asp-action="Index" method="post">

    <div>
        <label>Name</label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color:red"></span>
    </div>

    <br />

    <div>
        <label>Age</label><br />
        <input asp-for="Age" />
        <span asp-validation-for="Age" style="color:red"></span>
    </div>

    <br />

    <div>
        <label>Email</label><br />
        <input asp-for="Email" />
        <span asp-validation-for="Email" style="color:red"></span>
    </div>

    <br />

    <div>
        <label>Mobile</label><br />
        <input asp-for="Mobile" />
        <span asp-validation-for="Mobile" style="color:red"></span>
    </div>

    <br />

    <button type="submit">Submit</button>

</form>

@if (ViewBag.Message != null)
{
    <h3 style="color:green">@ViewBag.Message</h3>
}

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}